---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	planner(planner)
	researcher(researcher)
	writer(writer)
	editor(editor)
	reflector(reflector)
	exporter(exporter)
	__end__([<p>__end__</p>]):::last
	__start__ --> planner;
	editor -.-> exporter;
	editor -.-> reflector;
	planner --> researcher;
	reflector --> researcher;
	researcher --> writer;
	writer -.-> editor;
	writer -.-> exporter;
	exporter --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
